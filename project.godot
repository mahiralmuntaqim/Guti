; Engine configuration file.
; Brine Time - an original fishing game prototype.

config_version=5

[application]

config/name="Brine Time"
config/description="Cast, fight, sell, upgrade. A tiny island fishing prototype."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Data="*res://scripts/data.gd"
Game="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
